# Gradle
.gradle/
build/
out/

# 构建产物（独立仓库里 forge-1.20.1 会往 <repo>/dist 落 jar；
# monorepo 里由 yard/.gitignore 兜住，独立仓库必须自己声明，否则 dist/ 会变成待提交目录）
dist/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
bin/

# 运行时
run/
runs/
eclipse/
*.log

# 仅用于编译的第三方 jar：不要提交、也不要打进发布包
# （当前没有第三方编译期依赖；将来若重建 libs/ 放 jar，这两条继续生效）
libs/*.jar
!libs/*.md
